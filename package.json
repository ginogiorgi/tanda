{
  "name": "tanda",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:watch": "vitest --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x edge-runtime,gotrue,imgproxy,kong,logflare,mailpit,postgres-meta,postgrest,realtime,storage-api,studio,supavisor,vector",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "catalog:check": "tsx scripts/catalog/build-seed.ts",
    "catalog:build": "tsx scripts/catalog/build-seed.ts",
    "questions:check": "tsx scripts/questions/check.ts",
    "questions:topics": "tsx scripts/questions/check.ts --report --write-topics"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/bundle-analyzer": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "knip": "^6.45.1",
    "pg": "^8.23.1",
    "supabase": "^2.106.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "zod": "^4.6.7"
  }
}
