{
  "name": "tanda",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "knip": "knip",
    "perf:budget": "tsx scripts/perf/budget.ts",
    "db:check-migrations": "tsx scripts/db/check-migrations.ts",
    "assets:check": "tsx scripts/assets/unused.ts",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:watch": "vitest --project unit",
    "test:components": "vitest run --project components",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "test:e2e:flow": "bash scripts/e2e/flow.sh",
    "db:start": "supabase start -x edge-runtime,gotrue,imgproxy,kong,logflare,mailpit,postgres-meta,postgrest,realtime,storage-api,studio,supavisor,vector",
    "e2e:stack": "supabase start -x edge-runtime,imgproxy,logflare,vector,studio,storage-api,postgres-meta,supavisor,mailpit",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "catalog:check": "tsx scripts/catalog/build-seed.ts",
    "catalog:build": "tsx scripts/catalog/build-seed.ts",
    "avatar:build": "tsx scripts/avatar/build-glb.mts",
    "brand:icons": "python3 scripts/brand/build_icons.py assets/fonts/BigShouldersDisplay-Black.ttf",
    "brand:divisions": "python3 scripts/brand/build_divisions.py assets/fonts/BigShouldersDisplay-Black.ttf",
    "crests:build": "python3 scripts/crests/build_crests.py assets/fonts/BigShouldersDisplay-Black.ttf",
    "questions:check": "tsx scripts/questions/check.ts",
    "questions:topics": "tsx scripts/questions/check.ts --report --write-topics",
    "qa:avatar": "tsx scripts/avatar/qa.mts",
    "qa:celebrations": "tsx scripts/avatar/celebrations-qa.mts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@next/bundle-analyzer": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "happy-dom": "^21.0.4",
    "knip": "^6.47.0",
    "meshoptimizer": "^1.3.0",
    "pg": "^8.23.1",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
