{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/{page,layout,route,error,not-found,sitemap,robots,manifest,icon,apple-icon,opengraph-image,template,loading,default}.{ts,tsx}",
    "app/**/actions.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "scripts/**/*.ts",
    "e2e/**/*.spec.ts",
    "playwright.flow.config.ts",
    "playwright.shots.config.ts",
    "lib/supabase/database.types.check.ts"
  ],
  "project": [
    "**/*.{ts,tsx,mts,css}"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "ffmpeg",
    "montage"
  ],
  "ignore": [
    "lib/supabase/database.generated.ts"
  ]
}
