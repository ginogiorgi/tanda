# Tanda — variables de entorno
# Copiá este archivo a .env.local y completá con los valores de tu proyecto Supabase.
# Supabase usa el formato nuevo de claves: sb_publishable_... (cliente) y sb_secret_... (server).

# Públicas (seguras para el cliente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (Edge Functions / scripts de seed / CI). NUNCA exponer al cliente.
SUPABASE_SECRET_KEY=

# URL pública del sitio (links absolutos en mails). En dev podés omitirla (cae a localhost).
NEXT_PUBLIC_SITE_URL=

# Resend — envío de mails de recuperación. Solo servidor. NUNCA exponer al cliente.
RESEND_API_KEY=
